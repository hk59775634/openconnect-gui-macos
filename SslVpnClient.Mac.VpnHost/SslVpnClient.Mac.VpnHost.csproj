<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SslVpnClient.Mac</RootNamespace>
    <AssemblyName>ocg-vpnhost</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SslVpnClient.Mac\Native\OpenConnectNative.cs" Link="Native\OpenConnectNative.cs" />
    <Compile Include="..\SslVpnClient.Mac\Native\OpenConnectAuthFormHandler.cs" Link="Native\OpenConnectAuthFormHandler.cs" />
    <Compile Include="..\SslVpnClient.Mac\Native\OpenConnectProgressBridge.cs" Link="Native\OpenConnectProgressBridge.cs" />
    <Compile Include="..\SslVpnClient.Mac\Native\NativeLibraryBootstrap.cs" Link="Native\NativeLibraryBootstrap.cs" />
    <Compile Include="..\SslVpnClient.Mac\Vpn\OpenConnectLibEngine.cs" Link="Vpn\OpenConnectLibEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
